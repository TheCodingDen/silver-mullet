// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IgnoreTarget {
  CATEGORY
  CHANNEL
  ROLE
}

model Ignore {
  id        String       @id @default(cuid())
  type      IgnoreTarget
  snowflake String       @unique
}

enum PermissionGroup {
  ROOT
  INFRA_ADMIN
  ADMIN
  MODERATOR
}

model PermissionGroupMapping {
  id      String          @id @default(cuid())
  roleID  String          @unique
  guildID String
  group   PermissionGroup
}

model CrossChannelAntiSpamSettings {
  version                         Int @id @default(autoincrement())
  minMessageLength                Int
  shortMessageLength              Int
  shortMessageSimilarityThreshold Int
  similarityThreshold             Int
  maxTimeDiffMinutes              Int
  maxSizeDiffPercentage           Int // ?
  pointRequirement                Int
  pointsOnMatch                   Int

  pointOverrides PointOverride[] @relation("pointOverrides")
}

model PointOverride {
  id     String @id @default(cuid())
  word   String @unique
  points Int

  settings CrossChannelAntiSpamSettings[] @relation("pointOverrides")
}
