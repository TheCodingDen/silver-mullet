// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IgnoreTarget {
  CATEGORY
  CHANNEL
  ROLE
}

model Ignore {
  id        String       @id @default(cuid())
  type      IgnoreTarget
  snowflake String       @unique
}

enum PermissionGroup {
  ROOT
  INFRA_ADMIN
  ADMIN
  MODERATOR
}

model PermissionGroupMapping {
  id      String          @id @default(cuid())
  roleID  String          @unique
  guildID String
  group   PermissionGroup
}

model CrossChannelAntiSpamSettings {
  version                         Int @id @default(autoincrement())
  minMessageLength                Int
  shortMessageLength              Int
  shortMessageSimilarityThreshold Int
  similarityThreshold             Int
  cacheTTLSeconds                 Int
  maxSizeDiffPercentage           Int
  pointsOnMatch                   Int

  pointOverrides PointOverride[] @relation("pointOverrides")
  rules          AntiSpamRule[]  @relation("rules")
}

enum AntiSpamAction {
  BAN
  KICK
  QUEUE_BAN
  QUEUE_KICK
  NOTHING
}

enum AntiSpamType {
  FILTER
  SPAM
}

model AntiSpamRule {
  id String @id @default(cuid())

  pointThreshold Int?
  triggeringPhrase String?
  description      String?

  action           AntiSpamAction
  type             AntiSpamType

  settings        CrossChannelAntiSpamSettings? @relation("rules", fields: [settingsVersion], references: [version], onDelete: Cascade)
  settingsVersion Int?

  parentId String?
  parent   AntiSpamRule?  @relation("parentId", fields: [parentId], references: [id])
  children AntiSpamRule[] @relation("parentId")
}

model PointOverride {
  id     String @id @default(cuid())
  word   String @unique
  points Int

  settingsVersion Int
  settings        CrossChannelAntiSpamSettings @relation("pointOverrides", fields: [settingsVersion], references: [version], onDelete: Cascade)
}
