// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IgnoreTarget {
  CATEGORY
  CHANNEL
  ROLE
}

model Ignore {
  id        String       @id @default(cuid())
  type      IgnoreTarget
  snowflake String       @unique
  guildId   String
}

enum PermissionGroup {
  ROOT
  INFRA_ADMIN
  ADMIN
  MODERATOR
}

model PermissionGroupMapping {
  id      String          @id @default(cuid())
  roleID  String          @unique
  guildID String
  group   PermissionGroup
}

model CrossChannelAntiSpamSettings {
  version                         Int    @id @default(autoincrement())
  guildID                         String
  minMessageLength                Int
  shortMessageLength              Int
  shortMessageSimilarityThreshold Int
  similarityThreshold             Int
  cacheTTLSeconds                 Int
  maxSizeDiffPercentage           Int
  pointsOnMatch                   Int

  pointOverrides PointOverride[]         @relation("pointOverrides")
  actionMappings AntiSpamActionMapping[] @relation("actionMappings")
}

enum AntiSpamAction {
  BAN
  KICK
  MUTE
  QUEUE_BAN
  QUEUE_KICK
  QUEUE_MUTE
}

model AntiSpamActionMapping {
  id String @id @default(cuid())

  points Int
  action AntiSpamAction

  settings        CrossChannelAntiSpamSettings? @relation("actionMappings", fields: [settingsVersion], references: [version], onDelete: Cascade)
  settingsVersion Int?
}

model PointOverride {
  id     String @id @default(cuid())
  word   String @unique
  points Int

  settingsVersion Int
  settings        CrossChannelAntiSpamSettings @relation("pointOverrides", fields: [settingsVersion], references: [version], onDelete: Cascade)
}

model Filter {
  id      String         @id @default(cuid())
  guildID String
  regex   String
  action  AntiSpamAction @default(BAN)
  flags   String         @default("g")
}

enum DomainVerdict {
  MALICIOUS
  BENIGN
}

model Link {
  id      String        @id @default(cuid())
  verdict DomainVerdict
  categories String[]
  domain  String
  caughtURL String
  guildID String
}
