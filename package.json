{
  "name": "silver-mullet",
  "version": "1.0.0",
  "description": "The third attempt at making our own automod bot",
  "main": "lib/src/index.js",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "start": "nodemon lib/src/index.js",
    "dev": "concurrently --kill-others --prefix [{name}] --names tsc,cleaner,node \"npm:build:watch\" \"npm:cleaner\" \"npm:start\"",
    "cleaner": "ts-cleaner --dist lib --watch",
    "sync": "slash-up sync",
    "sync:dev": "slash-up sync -e development",
    "sync:prod": "slash-up sync --debug",
    "build": "tsc",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "test": "dotenv -e .env.test",
    "test:base": "docker compose up -d test-db test-redis && wait-for --postgresql --redis && prisma migrate dev && jest --verbose --runInBand",
    "test:watch": "npm run test:base -- --watch",
    "test:coverage": "npm run test:base -- --config jest.coverage.js",
    "test:coverage:watch": "npm run test:base -- --watchAll --config jest.coverage.js",
    "lint": "eslint . --ext .ts",
    "task:report": "node lib/tasks/report-scans.js",
    "doc": "typedoc --out docs src",
    "deploy-migrations": "prisma migrate deploy",
    "bootstrap": "docker compose up -d --force-recreate --renew-anon-volumes && POSTGRESQL_URI=postgres://postgres:password@127.0.0.1:5432/silver-mullet wait-for -q --postgresql && npm run deploy-migrations && prisma db execute --file scripts/init-local-dev-db.sql",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheCodingDen/silver-mullet.git"
  },
  "author": "The Coding Den",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheCodingDen/silver-mullet/issues"
  },
  "homepage": "https://github.com/TheCodingDen/silver-mullet#readme",
  "dependencies": {
    "@prisma/client": "^4.16.1",
    "cloudflare": "^4.0.0",
    "decancer": "^1.6.5",
    "didyoumean2": "^5.0.0",
    "discord.js": "^14.11.0",
    "dotenv-safe": "^8.2.0",
    "extract-urls": "^1.4.1",
    "lodash": "^4.17.21",
    "pino": "^8.14.1",
    "pino-pretty": "^10.0.0",
    "prisma": "^4.16.1",
    "redis": "^4.6.7",
    "redis-om": "^0.4.0-beta.3",
    "slash-create": "^6.0.1",
    "slash-up": "^1.4.2",
    "typescript": "^5.1.3",
    "wildcard-match": "^5.1.4"
  },
  "devDependencies": {
    "@swarthy/wait-for": "^2.1.1",
    "@types/dotenv-safe": "^8.1.2",
    "@types/jest": "^29.5.2",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^5.60.0",
    "@typescript-eslint/parser": "^5.60.0",
    "concurrently": "^8.2.0",
    "dotenv-cli": "^7.2.1",
    "eslint": "^8.43.0",
    "eslint-config-standard-with-typescript": "^35.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^16.0.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-tsdoc": "^0.2.17",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^13.2.2",
    "moq.ts": "^10.0.8",
    "nodemon": "^2.0.22",
    "patch-package": "^8.0.0",
    "ts-cleaner": "^1.0.5",
    "ts-jest": "^29.1.0",
    "typedoc": "^0.24.8"
  },
  "lint-staged": {
    "*.(ts|js)": "npm run lint -- --fix"
  }
}
